stock CEFSysOpen(playerid, system_id)
{
    switch (system_id) {
        case 1:  { if (!gSys[sys_chat])      return CEF_NotReady(playerid, "чат");      CEF_CmdChat(playerid, ""); }
        case 2:  { if (!gSys[sys_documents]) return CEF_NotReady(playerid, "документы"); CEF_CmdDocuments(playerid, ""); }
        case 3:  { if (!gSys[sys_plate])     return CEF_NotReady(playerid, "номера");   return 1; }
        case 4:  { if (!gSys[sys_radial])    return CEF_NotReady(playerid, "меню");     return 1; }
        case 5:  { if (!gSys[sys_cases])     return CEF_NotReady(playerid, "кейсы");    return 1; }
        case 6:  { if (!gSys[sys_bp])        return CEF_NotReady(playerid, "батлпасс"); return 1; }
        default: return CEF_NotReady(playerid, "эта система");
    }
    return 1;
}

stock CEF_NotReady(playerid, const what[])
{
    new msg[128];
    format(msg, sizeof msg, "[CEF] %s пока недоступно на сервере.", what);
    SendClientMessage(playerid, 0xFFAA00FF, msg);
    return 0;
}
